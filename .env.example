# Zeus Agent — Railway environment variables
# Copy sang Railway: Dashboard → Service → Variables
# Reference: docs/full_spec/tool/AGENT-SPEC.md §9.2

# Supabase (bắt buộc)
SUPABASE_URL=https://wuyxkksihkmsmwuiuvdk.supabase.co
SUPABASE_ANON_KEY=<anon key từ Supabase Dashboard → Settings → API>

# Device identity — được agent tự sinh lúc boot đầu tiên và lưu vào /opt/knight/state/device.json
# KHÔNG cần set thủ công. Agent dùng RAILWAY_SERVICE_ID làm seed để sinh key pair P-256.
# RAILWAY_SERVICE_ID được Railway tự inject.

# Pair code — agent tự sinh, hiển thị trong log lúc boot lần đầu.
# Web dashboard đọc code này và gọi RPC claim_device để pair.

# Game settings (optional — đã có default trong Dockerfile)
# HEAP_MAX=320m
# VNC_GEOMETRY=800x600
# PORT=6080
